# Imagem de produção do frontend (a de desenvolvimento é o Dockerfile).

# Stage 1: build estático com o Vite
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

# A API fica no mesmo domínio; o nginx repassa /api para o backend
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Stage 2: nginx servindo os arquivos e fazendo proxy da API
FROM nginx:1.27-alpine

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
