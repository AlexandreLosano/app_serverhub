# MongoDB Configuration (External Container)
# MongoDB rodando em /home/alosano/repositorios/ser_mongodb
# Usa host.docker.internal para evitar dependência do IP LAN da máquina
MONGO_URI=mongodb://admin:admin@host.docker.internal:27017/server_hub?authSource=admin

# Backend Configuration
NODE_ENV=development
PORT=3000

# Frontend Configuration
# Substitua YOUR_SERVER_IP pelo IP LAN da máquina host (ex: 192.168.15.15)
# Porta 30000 = backend. Incluir /api no path.
VITE_API_URL=http://YOUR_SERVER_IP:30000/api
