# SQLite Configuration
# O arquivo .db é criado automaticamente em ./data/database.db
# Abra-o com DB Browser for SQLite para visualizar os dados
DB_PATH=/app/data/database.db

# Backend Configuration
NODE_ENV=development
PORT=3000

# Frontend Configuration
# Substitua YOUR_SERVER_IP pelo IP LAN da máquina host (ex: 192.168.15.15)
# Porta 30000 = backend. Incluir /api no path.
VITE_API_URL=http://YOUR_SERVER_IP:30000/api
